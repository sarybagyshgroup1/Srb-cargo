function clientRate(code,cat,byM3){
  var c=S.clients.find(function(x){return x.code===code});
  if(!c||!c.rates)return 0;
  var k=(byM3?"m":"k")+cat;
  return +c.rates[k]||0;
}
function catOf(n){return S.cfg.cats.find(function(c){return c.n===+n})||S.cfg.cats[0]}
function dens(w,m3){return (+m3>0)?(+w/+m3):99999}
function tierFor(cat,d){
  var C=catOf(cat);
  for(var i=0;i<C.t.length;i++){if(d>=C.t[i][0])return{min:C.t[i][0],rate:C.t[i][1],byM3:false}}
  return{min:0,rate:C.m3,byM3:true};
}
function calc(){
  S.cargo.forEach(function(c){
    var C=catOf(c.cat);
    c._d=dens(c.w,c.m3);
    var t=tierFor(c.cat,c._d);
    c._byM3=t.byM3;c._unit=t.byM3?"м³":"кг";
    c._qty=t.byM3?(+c.m3||0):(+c.w||0);
    c._costR=t.rate;
    var indiv=clientRate(c.code,c.cat,t.byM3);
    c._indiv=!!(indiv&&!(+c.sell>0));
    c._sellR=(+c.sell>0)?+c.sell:(indiv||(t.rate+(t.byM3?S.cfg.mkM3:S.cfg.mkKg)));
    var pk=(+c.pack||0)+(+c.svc||0);
    c._cost=c._qty*c._costR+pk;
    c._rev=c._qty*c._sellR+pk;
    c._prof=c._rev-c._cost;
    c._som=c._rev*S.cfg.usd;
  });
}
function buyCharged(b){return STAGES.indexOf(b.st)>=3}
function cname(code){var c=S.clients.find(function(x){return x.code===code});return c&&c.name?c.name:""}
function tripOf(id){return S.trips.find(function(t){return t.id===id})}
function stats(){
  var acc={},paid={};
  S.cargo.forEach(function(c){acc[c.code]=(acc[c.code]||0)+(c._som||0)});
  S.buys.forEach(function(b){if(buyCharged(b)&&b.code)acc[b.code]=(acc[b.code]||0)+((+b.cost||0)+(+b.comm||0))*S.cfg.usd});
  S.fin.forEach(function(f){if(f.t==="in"&&f.k)paid[f.k]=(paid[f.k]||0)+f.s});
  return{acc:acc,paid:paid};
}
