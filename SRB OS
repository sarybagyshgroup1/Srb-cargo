  id:["货号","номер груза","груз","code","编号","cargo"],
  name:["品名","наимен","товар","货物","name","описан"],
  pcs:["件数","мест","кол","qty","pcs","количество"],
  w:["重量","вес","weight","kg","кг"],
  m3:["体积","объ","куб","volume","cbm","m3","м3"],
  dn:["密度","плотн","density"],
  pack:["打包","упаков","垫付","pack"],
  date:["入库日期","дата","date","日期"],
