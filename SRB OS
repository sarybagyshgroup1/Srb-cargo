<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SRB Cargo OS</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
html[data-theme=dark]{
  --bg:#0E1113;--bg2:#14181B;--card:#191E21;--card2:#20262A;--line:#2A3237;
  --tx:#E8EDF0;--tx2:#98A4AD;--tx3:#6C7880;
  --acc:#2FA06E;--acc2:#5FD39A;--deep:#14624A;
  --blue:#4C93E8;--cyan:#22B8CF;--amber:#E8A833;--red:#EE6A55;--vio:#9B8CF0;
  --shadow:0 20px 46px -28px rgba(0,0,0,.85);--glow:0 0 0 1px rgba(47,160,110,.22);
}
html[data-theme=light]{
  --bg:#F3F4F6;--bg2:#FFFFFF;--card:#FFFFFF;--card2:#F7F8FA;--line:#E3E6EA;
  --tx:#15181C;--tx2:#5B646F;--tx3:#8B939E;
  --acc:#12805C;--acc2:#0EA470;--deep:#0C5B42;
  --blue:#2C74D6;--cyan:#0A93AC;--amber:#C2820E;--red:#D2493A;--vio:#6A57CC;
  --shadow:0 12px 30px -18px rgba(21,24,28,.22);--glow:0 0 0 1px rgba(18,128,92,.14);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--tx);font-family:Inter,system-ui,sans-serif;font-size:14px;-webkit-font-smoothing:antialiased;transition:background .35s,color .35s}
.mono{font-family:"JetBrains Mono",monospace;font-variant-numeric:tabular-nums}
h1,h2,h3,h4{font-family:Manrope,sans-serif;font-weight:700;letter-spacing:-.02em}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:9px}
::-webkit-scrollbar-thumb:hover{background:var(--acc)}

/* ===== LOGIN ===== */
#login{position:fixed;inset:0;z-index:200;display:grid;place-items:center;
  background:radial-gradient(1100px 700px at 25% 15%,var(--deep),var(--bg) 62%)}
#login.off{display:none}
.lg{width:340px;max-width:92vw;text-align:center}
.lgb{width:58px;height:58px;border-radius:19px;margin:0 auto 16px;display:grid;place-items:center;
  background:linear-gradient(140deg,var(--acc2),var(--acc));color:#07160F;font-family:Manrope;font-weight:800;font-size:25px;
  box-shadow:0 12px 34px -10px rgba(92,168,124,.55);animation:fl 4s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(-6px)}}
.lg h1{font-size:25px;margin-bottom:4px}
.lg p{color:var(--tx2);font-size:13px;margin-bottom:20px}
.users{display:grid;gap:8px;margin-bottom:14px}
.ub{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:14px;background:var(--card);
  border:1px solid var(--line);text-align:left;transition:.2s}
.ub:hover{border-color:var(--acc);transform:translateX(3px)}
.ub.on{border-color:var(--acc);box-shadow:var(--glow)}
.ub b{display:block;font-family:Manrope;font-size:14px}
.ub span{color:var(--tx3);font-size:11px}
.av{width:32px;height:32px;border-radius:11px;display:grid;place-items:center;font-family:Manrope;font-weight:700;font-size:13px;color:#07160F}
.pin{display:flex;gap:7px;justify-content:center;margin-bottom:12px}
.pin input{width:46px;height:52px;text-align:center;font-size:21px;font-family:"JetBrains Mono";
  background:var(--card);border:1px solid var(--line);border-radius:13px;outline:0;transition:.18s}
.pin input:focus{border-color:var(--acc);box-shadow:var(--glow);transform:scale(1.05)}
.shake{animation:sh .4s}
@keyframes sh{0%,100%{transform:none}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* ===== SHELL ===== */
.app{display:grid;grid-template-columns:236px 1fr;min-height:100vh}
aside{background:var(--bg2);border-right:1px solid var(--line);padding:16px 12px;display:flex;flex-direction:column;gap:3px;position:sticky;top:0;height:100vh}
.brand{display:flex;align-items:center;gap:10px;padding:6px 8px 14px}
.brand .b{width:32px;height:32px;border-radius:11px;background:linear-gradient(140deg,var(--acc2),var(--acc));color:#07160F;display:grid;place-items:center;font-family:Manrope;font-weight:800;font-size:16px}
.brand b{font-family:Manrope;font-size:17px}
.brand small{display:block;color:var(--tx3);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-top:-2px}
.nlab{color:var(--tx3);font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:12px 10px 5px}
.nav{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:12px;color:var(--tx2);width:100%;text-align:left;font-weight:500;position:relative;transition:.18s}
.nav:hover{background:var(--card);color:var(--tx);transform:translateX(2px)}
.nav.on{background:linear-gradient(100deg,var(--acc),var(--deep));color:#fff;font-weight:600;box-shadow:0 8px 20px -12px var(--acc)}
html[data-theme=light] .nav.on{color:#fff}
.nav .ic{width:16px;text-align:center;font-size:13px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 16px}
.nav .cnt{margin-left:auto;font-size:11px;background:var(--card2);color:var(--tx2);padding:1px 7px;border-radius:20px}
.nav.on .cnt{background:rgba(255,255,255,.22);color:#fff}
.nav.hide{display:none}
aside .foot{margin-top:auto;border-top:1px solid var(--line);padding-top:11px}
.me{display:flex;align-items:center;gap:9px;padding:7px;border-radius:12px}
.me b{font-size:12.5px;font-family:Manrope}.me span{color:var(--tx3);font-size:10.5px;display:block}

main{padding:18px 22px 44px;min-width:0}
.top{display:flex;align-items:center;gap:11px;margin-bottom:16px;flex-wrap:wrap}
.top h1{font-size:23px}
.crumb{color:var(--tx3);font-size:12px}
.search{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 12px;min-width:190px;transition:.2s}
.search:focus-within{border-color:var(--acc);box-shadow:var(--glow)}
.search input{background:none;border:0;outline:0;width:100%;color:var(--tx)}
.search input::placeholder{color:var(--tx3)}

/* buttons */
.btn{background:linear-gradient(100deg,var(--acc),var(--deep));color:#fff;font-weight:600;padding:9px 16px;border-radius:12px;position:relative;overflow:hidden;transition:.18s;box-shadow:0 8px 18px -12px var(--acc)}
.btn::after{content:"";position:absolute;top:0;left:-120%;width:60%;height:100%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);transition:.55s}
.btn:hover::after{left:130%}
.btn:hover{transform:translateY(-2px);box-shadow:0 12px 24px -12px var(--acc)}
.btn:active{transform:translateY(0) scale(.97)}
.btn.g{background:var(--card);color:var(--tx);border:1px solid var(--line);box-shadow:none}
.btn.g:hover{border-color:var(--acc);background:var(--card2)}
.btn.sm{padding:6px 12px;font-size:12.5px;border-radius:10px}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.42);transform:scale(0);animation:rp .55s ease-out;pointer-events:none}
@keyframes rp{to{transform:scale(3.2);opacity:0}}
.tgl{display:flex;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:3px}
.tgl button{padding:5px 11px;border-radius:8px;font-size:12px;color:var(--tx3);transition:.18s}
.tgl button.on{background:linear-gradient(100deg,var(--acc),var(--deep));color:#fff}

.grid{display:grid;gap:12px}
.k5{grid-template-columns:repeat(5,1fr)}.k4{grid-template-columns:repeat(4,1fr)}
.k3{grid-template-columns:repeat(3,1fr)}.k2{grid-template-columns:1fr 1fr}
.c23{grid-template-columns:1.4fr 1fr}
@media(max-width:1250px){.k5{grid-template-columns:repeat(3,1fr)}}
@media(max-width:1050px){.k5,.k4{grid-template-columns:1fr 1fr}.c23,.k3,.k2{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:17px;padding:15px;transition:.22s;position:relative;overflow:hidden}
.card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--acc),transparent);opacity:0;transition:.3s}
.card:hover::before{opacity:0}
html[data-theme=dark] .card.hi{background:linear-gradient(150deg,#1D5C46,#12301F);border-color:var(--acc);color:#EAF7EE}
html[data-theme=dark] .card.hi .lab,html[data-theme=dark] .card.hi .d{color:#A9D7BC}
html[data-theme=dark] .card.hi .lab i{background:rgba(255,255,255,.14);color:#DFF6E6}
html[data-theme=light] .card.hi{background:linear-gradient(150deg,#D8F0E1,#F3FBF6);border-color:var(--acc2)}
html[data-theme=light] .card.hi .lab{color:#2C6B4E}
html[data-theme=light] .card.hi .lab i{background:#fff;color:var(--acc)}
html[data-theme=light] .card.hi .v{color:#14513A}
.card.hi::after{content:"";position:absolute;right:-30px;bottom:-40px;width:130px;height:130px;border-radius:50%;
  background:radial-gradient(circle,color-mix(in srgb,var(--acc) 35%,transparent),transparent 70%);pointer-events:none}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(900px 500px at 88% -12%,color-mix(in srgb,var(--acc) 7%,transparent),transparent 62%)}
main,aside{position:relative;z-index:1}
/* greeting */
.hello{display:flex;align-items:center;gap:13px;background:var(--card);border:1px solid var(--line);
  border-left:3px solid var(--acc);border-radius:14px;padding:13px 16px;margin-bottom:13px;color:var(--tx);position:relative}
.hello::after{display:none}
.hello .hi{width:38px;height:38px;border-radius:12px;background:var(--card2);color:var(--acc);
  display:grid;place-items:center;font-family:Manrope;font-weight:800;font-size:15px;border:1px solid var(--line)}
.hello b{font-family:Manrope;font-size:17px;display:block;letter-spacing:-.02em}
.hello span{font-size:12.5px;color:var(--tx2)}
.hello .pill{margin-left:auto;background:var(--card2);border:1px solid var(--line);color:var(--tx2);
  padding:6px 12px;border-radius:9px;font-size:12px;font-weight:600;position:relative;z-index:2}
/* sparkline */
.spark{position:absolute;right:12px;top:14px;opacity:.55;pointer-events:none}
.spark path{fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.kpi{position:relative}
/* chart grid */
.chartwrap{position:relative}
.gl{position:absolute;left:0;right:0;height:1px;background:var(--line);opacity:.55}
.gl span{position:absolute;right:0;top:-13px;font-size:9.5px;color:var(--tx3);font-family:"JetBrains Mono"}
.bars div{position:relative}
.bars div:hover::after{content:attr(title);position:absolute;bottom:calc(100% + 7px);left:50%;transform:translateX(-50%);
  background:var(--tx);color:var(--bg);padding:4px 9px;border-radius:8px;font-size:11px;white-space:nowrap;font-family:"JetBrains Mono";z-index:5}
.livedot{width:7px;height:7px;border-radius:50%;background:var(--amber);display:inline-block;margin-right:6px;
  box-shadow:0 0 0 0 color-mix(in srgb,var(--amber) 60%,transparent);animation:pu 2s infinite}
.card h3{font-size:15px;margin-bottom:2px}
.card .cs{color:var(--tx3);font-size:12px}
.chead{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.chead .r{margin-left:auto}
.kpi .lab{color:var(--tx2);font-size:12px;display:flex;align-items:center;gap:7px}
.kpi .lab i{width:23px;height:23px;border-radius:8px;background:var(--card2);display:grid;place-items:center;font-style:normal;font-size:12px;color:var(--acc2)}
.kpi .v{font-family:Manrope;font-weight:800;font-size:26px;letter-spacing:-.03em;margin:9px 0 3px;font-variant-numeric:tabular-nums}
.kpi .d{font-size:11.5px;color:var(--tx3)}
.kpi .d b{font-weight:600}
.up{color:var(--acc2)}.down{color:var(--red)}
html[data-theme=light] .up{color:var(--acc)}

.bars{display:flex;align-items:flex-end;gap:4px;height:112px;margin-top:6px}
.bars div{flex:1;background:var(--card2);border-radius:5px 5px 2px 2px;min-height:2px;transition:.25s;animation:gr .6s ease-out}
@keyframes gr{from{height:0!important}}
.bars div.a{background:linear-gradient(180deg,var(--acc2),var(--acc))}
.bars div.o{background:linear-gradient(180deg,color-mix(in srgb,var(--amber) 70%,transparent),color-mix(in srgb,var(--amber) 35%,transparent))}
.bars div:hover{filter:brightness(1.25);transform:scaleY(1.03)}
.xax{display:flex;gap:4px;margin-top:6px}
.xax span{flex:1;text-align:center;color:var(--tx3);font-size:9.5px}
.legend{display:flex;gap:14px;font-size:11.5px;color:var(--tx2);margin-top:10px}
.legend i{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:5px}

.pl{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px}
.pl:last-of-type{border:0}
.pl i{width:10px;height:10px;border-radius:3px;flex:0 0 10px}
.pl span{color:var(--tx2);flex:1}
.pl b{font-family:"JetBrains Mono";font-size:13px}
.plbar{display:flex;height:10px;border-radius:6px;overflow:hidden;margin:4px 0 12px;background:var(--card2)}
.plbar i{display:block;height:100%;transition:width .6s}
.tot{margin-top:11px;padding-top:11px;border-top:2px solid var(--acc);display:flex;align-items:baseline}
.tot span{color:var(--tx2);font-size:12.5px;flex:1}
.tot b{font-family:Manrope;font-size:23px}

.tw{overflow-x:auto;margin:0 -15px}
table{width:100%;border-collapse:collapse;min-width:760px}
th{text-align:left;color:var(--tx3);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500;padding:8px 9px;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{padding-left:15px}th:last-child,td:last-child{padding-right:15px}
td{padding:10px 9px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:middle}
tr:last-child td{border-bottom:0}
tbody tr{transition:.14s}
tbody tr:hover{background:var(--card2)}
tr.clickable{cursor:pointer}
.code{font-family:"JetBrains Mono";font-weight:700;font-size:12.5px;color:var(--acc2)}
html[data-theme=light] .code{color:var(--acc)}
.mut{color:var(--tx2)}.rt{text-align:right}
.tag{display:inline-block;font-size:10.5px;padding:3px 9px;border-radius:20px;white-space:nowrap;font-weight:500}
.t-1{background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber)}
.t-2{background:color-mix(in srgb,var(--acc) 20%,transparent);color:var(--acc2)}
.t-3{background:color-mix(in srgb,var(--blue) 18%,transparent);color:var(--blue)}
.t-4{background:color-mix(in srgb,var(--cyan) 18%,transparent);color:var(--cyan)}
.t-5{background:var(--card2);color:var(--tx2)}
.t-r{background:color-mix(in srgb,var(--red) 18%,transparent);color:var(--red)}
.t-v{background:color-mix(in srgb,var(--vio) 18%,transparent);color:var(--vio)}
html[data-theme=light] .t-2{color:var(--acc)}
.cat{display:inline-grid;place-items:center;width:21px;height:21px;border-radius:7px;font-size:11px;font-weight:700;font-family:Manrope}
.c1{background:color-mix(in srgb,var(--acc) 22%,transparent);color:var(--acc2)}
.c2{background:color-mix(in srgb,var(--blue) 20%,transparent);color:var(--blue)}
.c3{background:color-mix(in srgb,var(--amber) 20%,transparent);color:var(--amber)}
.c4{background:color-mix(in srgb,var(--red) 20%,transparent);color:var(--red)}
html[data-theme=light] .c1{color:var(--acc)}
.ed{width:68px;background:var(--bg2);border:1px solid var(--acc);border-radius:8px;padding:4px 7px;text-align:right;font-family:"JetBrains Mono";font-size:12px;color:var(--acc2);transition:.16s}
html[data-theme=light] .ed{color:var(--acc);background:var(--card2)}
.ed:focus{outline:0;box-shadow:var(--glow);transform:scale(1.06)}

.f{display:grid;gap:10px;grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.f{grid-template-columns:1fr 1fr}}
.fi label{display:block;color:var(--tx3);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:5px}
.fi input,.fi select,.fi textarea{width:100%;background:var(--bg2);border:1px solid var(--line);border-radius:11px;padding:9px 11px;outline:0;transition:.18s}
html[data-theme=light] .fi input,html[data-theme=light] .fi select{background:var(--card2)}
.fi input:focus,.fi select:focus{border-color:var(--acc);box-shadow:var(--glow)}
.hint{background:var(--bg2);border:1px dashed var(--line);border-radius:13px;padding:11px 13px;margin-top:11px;font-size:12.5px;color:var(--tx2);display:flex;gap:16px;flex-wrap:wrap;align-items:center}
html[data-theme=light] .hint{background:var(--card2)}
.hint b{color:var(--acc2);font-family:"JetBrains Mono"}
html[data-theme=light] .hint b{color:var(--acc)}

/* goals */
.goal{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;transition:.2s}
.goal:hover{border-color:var(--acc);transform:translateY(-2px)}
.goal .gh{display:flex;align-items:baseline;gap:8px;margin-bottom:9px}
.goal .gh b{font-family:Manrope;font-size:14.5px;flex:1}
.goal .gv{font-family:Manrope;font-size:25px;font-weight:800;margin-bottom:2px}
.goal .gt{color:var(--tx3);font-size:11.5px;margin-bottom:9px}
.prog{height:9px;background:var(--card2);border-radius:8px;overflow:hidden}
.prog i{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,var(--acc2),var(--acc));transition:width .8s cubic-bezier(.3,1,.4,1);position:relative}
.prog i::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:sw 2.2s infinite}
@keyframes sw{to{transform:translateX(100%)}}
.gpct{display:flex;justify-content:space-between;font-size:11px;color:var(--tx3);margin-top:6px}

/* kanban */
.kan{display:grid;grid-template-columns:repeat(6,minmax(210px,1fr));gap:10px;overflow-x:auto;padding-bottom:8px}
.col{background:var(--bg2);border:1px solid var(--line);border-radius:15px;padding:10px;min-width:210px}
html[data-theme=light] .col{background:var(--card2)}
.colh{display:flex;align-items:center;gap:7px;margin-bottom:9px}
.colh b{font-family:Manrope;font-size:12.5px;flex:1}
.colh span{font-size:11px;color:var(--tx3);background:var(--card);padding:1px 7px;border-radius:20px}
.rq{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px;margin-bottom:8px;transition:.18s}
.rq:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.rq img{width:100%;height:76px;object-fit:cover;border-radius:9px;margin-bottom:8px;background:var(--card2)}
.rq .t{font-size:13px;font-weight:600;line-height:1.3;margin-bottom:5px}
.rq .m{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-size:11px;color:var(--tx3);margin-bottom:6px}
.rq .money{display:flex;justify-content:space-between;font-family:"JetBrains Mono";font-size:11.5px;padding-top:6px;border-top:1px solid var(--line);margin-bottom:6px}
.rq select{width:100%;background:var(--bg2);border:1px solid var(--line);border-radius:9px;padding:5px 7px;font-size:11.5px}
.who{display:inline-grid;place-items:center;width:19px;height:19px;border-radius:50%;background:var(--acc);color:#fff;font-size:10px;font-weight:700;font-family:Manrope}

/* drawer */
.scrim{position:fixed;inset:0;background:rgba(3,10,7,.62);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:.25s;z-index:80}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:600px;max-width:95vw;background:var(--bg2);border-left:1px solid var(--line);z-index:81;transform:translateX(103%);transition:.3s cubic-bezier(.3,.9,.3,1);overflow-y:auto;padding:20px}
.drawer.on{transform:none}
.dh{display:flex;align-items:flex-start;gap:12px;margin-bottom:15px}
.dh h2{font-size:21px}
.dh .x{margin-left:auto;font-size:18px;color:var(--tx3);padding:2px 9px;border-radius:9px}
.dh .x:hover{background:var(--card);color:var(--tx)}
.dk{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:13px}
.dk div{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:9px 10px}
.dk b{font-family:Manrope;font-size:17px;display:block}
.dk span{color:var(--tx3);font-size:10px;text-transform:uppercase;letter-spacing:.06em}
.dtabs{display:flex;gap:5px;margin-bottom:12px}
.dtabs button{flex:1;padding:7px;border-radius:10px;background:var(--card);border:1px solid var(--line);font-size:12.5px;color:var(--tx2);transition:.18s}
.dtabs button.on{background:linear-gradient(100deg,var(--acc),var(--deep));color:#fff;border-color:transparent;font-weight:600}
.dsec{display:none}.dsec.on{display:block;animation:fi .25s}
@keyframes fi{from{opacity:0;transform:translateY(6px)}}
.li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:12.5px}
.li:last-child{border:0}
.li .g{flex:1;min-width:0}
.li .g b{font-weight:600;display:block}
.li .g span{color:var(--tx3);font-size:11px}

/* route */
.route{display:flex;align-items:center;gap:0;margin:14px 0}
.leg{flex:1;text-align:center;position:relative;padding:0 4px}
.leg .dot{width:13px;height:13px;border-radius:50%;background:var(--card2);border:2px solid var(--line);margin:0 auto 7px;position:relative;z-index:2}
.leg.done .dot{background:var(--acc);border-color:var(--acc)}
.leg.now .dot{background:var(--amber);border-color:var(--amber);box-shadow:0 0 0 5px color-mix(in srgb,var(--amber) 25%,transparent);animation:pu 1.8s infinite}
@keyframes pu{50%{box-shadow:0 0 0 9px transparent}}
.leg::before{content:"";position:absolute;top:6px;left:-50%;width:100%;height:2px;background:var(--line);z-index:1}
.leg:first-child::before{display:none}
.leg.done::before{background:var(--acc)}
.leg b{display:block;font-size:11.5px;font-family:Manrope}
.leg span{font-size:10.5px;color:var(--tx3);font-family:"JetBrains Mono"}

.tarcard{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--card)}
.tarhead{padding:11px 14px;display:flex;align-items:center;gap:9px}
.tarhead h4{font-size:15px;flex:1}
.targoods{padding:9px 14px;font-size:11.5px;line-height:1.4;background:var(--card2);color:var(--tx2)}
.tr{display:flex;align-items:center;gap:8px;padding:7px 14px;border-top:1px solid var(--line);font-size:12.5px}
.tr span{flex:1;color:var(--tx2);font-family:"JetBrains Mono";font-size:12px}
.tr input{width:78px;background:var(--bg2);border:1px solid var(--line);border-radius:9px;padding:5px 8px;text-align:right;font-family:"JetBrains Mono";font-size:12px}
html[data-theme=light] .tr input{background:var(--card2)}
.tr em{font-style:normal;color:var(--tx3);font-size:11px;width:36px}

.drop{border:2px dashed var(--line);border-radius:17px;padding:30px 20px;text-align:center;background:var(--bg2);cursor:pointer;transition:.2s}
html[data-theme=light] .drop{background:var(--card2)}
.drop:hover,.drop.over{border-color:var(--acc);transform:scale(1.008)}
.drop b{display:block;font-family:Manrope;font-size:17px;margin:9px 0 5px}
.drop p{color:var(--tx2);font-size:12.5px;max-width:60ch;margin:0 auto;line-height:1.55}
.map{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:13px}
@media(max-width:900px){.map{grid-template-columns:1fr 1fr}}
.stat3{display:flex;gap:9px;flex-wrap:wrap;margin:13px 0}
.st{flex:1;min-width:125px;background:var(--card2);border:1px solid var(--line);border-radius:13px;padding:11px 13px}
.st b{font-family:Manrope;font-size:20px;display:block}
.st span{color:var(--tx3);font-size:11px}
.st.new{border-color:var(--acc)}.st.dup{border-color:var(--amber)}

/* bell */
.bell{position:relative;width:38px;height:38px;border-radius:12px;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;transition:.18s}
.bell:hover{border-color:var(--acc);transform:translateY(-2px)}
.bell i{position:absolute;top:-4px;right:-4px;background:var(--red);color:#fff;font-style:normal;font-size:10px;font-weight:700;min-width:17px;height:17px;border-radius:9px;display:grid;place-items:center;padding:0 4px}
.notes{position:fixed;top:64px;right:22px;width:340px;max-width:92vw;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:13px;z-index:90;box-shadow:var(--shadow);display:none}
.notes.on{display:block;animation:fi .2s}
.nt{display:flex;gap:9px;padding:9px 0;border-bottom:1px solid var(--line);font-size:12.5px}
.nt:last-child{border:0}
.nt .g{flex:1}.nt .g b{display:block;font-size:12.5px}
.nt .g span{color:var(--tx3);font-size:10.5px}
.nt.done{opacity:.45}

.empty{text-align:center;padding:32px 16px;color:var(--tx3)}
.empty b{display:block;color:var(--tx2);font-family:Manrope;font-size:15px;margin-bottom:5px}
.page{display:none}.page.on{display:block;animation:fi .28s}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(80px);background:linear-gradient(100deg,var(--acc),var(--deep));color:#fff;padding:11px 20px;border-radius:13px;font-weight:600;transition:.32s;z-index:99;opacity:0;pointer-events:none;box-shadow:var(--shadow)}
.toast.on{transform:translateX(-50%);opacity:1}
.bar{height:6px;background:var(--card2);border-radius:6px;overflow:hidden;min-width:70px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc2),var(--acc));border-radius:6px;transition:width .6s}
/* perms */
.ucard{border:1px solid var(--line);border-radius:15px;padding:12px;background:var(--card2)}
.uh{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.uh b{font-family:Manrope;font-size:14px;display:block}
.uh span{color:var(--tx3);font-size:11px}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:6px}
.pchip{display:flex;align-items:center;gap:8px;padding:6px 9px;border-radius:10px;background:var(--card);
  border:1px solid var(--line);font-size:11.5px;color:var(--tx3);text-align:left;transition:.16s}
.pchip:hover:not(:disabled){border-color:var(--acc)}
.pchip:disabled{opacity:.55;cursor:default}
.pchip.on{color:var(--tx);border-color:var(--acc)}
.sw{width:26px;height:15px;border-radius:9px;background:var(--line);flex:0 0 26px;position:relative;transition:.2s}
.sw i{position:absolute;top:2px;left:2px;width:11px;height:11px;border-radius:50%;background:var(--tx3);transition:.2s}
.pchip.on .sw{background:var(--acc)}
.pchip.on .sw i{left:13px;background:#fff}
.invwrap{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card2)}
.invwrap img{display:block;width:100%;height:auto}
.invbar{display:flex;align-items:center;gap:9px;padding:11px 12px;border-top:1px solid var(--line);flex-wrap:wrap}
.invmeta{flex:1;min-width:120px}
.invmeta b{display:block;font-family:"JetBrains Mono";font-size:11.5px}
.invmeta span{color:var(--tx3);font-size:11px}
/* invoice */
.inv{background:#fff;color:#111;border-radius:14px;padding:18px;font-size:12.5px}
.inv h4{color:#111;font-size:17px;margin-bottom:2px}
.inv table{min-width:auto;width:100%}
.inv th,.inv td{color:#333;border-color:#ddd;padding:6px 5px;font-size:11.5px}
.inv th{color:#666}
.inv .ttl{display:flex;justify-content:space-between;border-top:2px solid #111;margin-top:8px;padding-top:8px;font-weight:700;font-size:15px}
.msg{background:var(--bg2);border:1px dashed var(--line);border-radius:12px;padding:11px;font-size:12.5px;white-space:pre-wrap;line-height:1.5;margin-bottom:8px}
/* multicolor accents */
.card{--ac:var(--acc)}
.card.ac-b{--ac:var(--blue)}.card.ac-c{--ac:var(--cyan)}
.card.ac-v{--ac:var(--vio)}.card.ac-a{--ac:var(--amber)}.card.ac-r{--ac:var(--red)}
.card::before{background:linear-gradient(90deg,transparent,var(--ac),transparent)}
.card:hover{border-color:color-mix(in srgb,var(--ac) 45%,var(--line))}
.kpi .lab i{background:color-mix(in srgb,var(--ac) 16%,transparent);color:var(--ac)}
.kpi.big .v{background:linear-gradient(96deg,var(--ac),color-mix(in srgb,var(--ac) 55%,var(--tx)));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.nlab::before{content:"";display:inline-block;width:6px;height:6px;border-radius:2px;margin-right:6px;
  background:var(--acc);vertical-align:middle}
.nlab.n2::before{background:var(--vio)}.nlab.n3::before{background:var(--amber)}
.legend i.b{background:var(--blue)}
.plbar i{transition:width .6s}
.tarcard.tc1{border-top:3px solid var(--acc)}.tarcard.tc2{border-top:3px solid var(--blue)}
.tarcard.tc3{border-top:3px solid var(--amber)}.tarcard.tc4{border-top:3px solid var(--red)}
.goal:nth-child(3n+2){--ac:var(--blue)}.goal:nth-child(3n+3){--ac:var(--vio)}
.goal{--ac:var(--acc)}
.goal .prog i{background:linear-gradient(90deg,color-mix(in srgb,var(--ac) 60%,#fff),var(--ac))}
.goal:hover{border-color:var(--ac)}
.goal .gv{color:var(--ac)}
html[data-theme=light] .goal .gv{color:color-mix(in srgb,var(--ac) 82%,#000)}
.col:nth-child(1){border-top:2px solid var(--tx3)}
.col:nth-child(2){border-top:2px solid var(--blue)}
.col:nth-child(3){border-top:2px solid var(--cyan)}
.col:nth-child(4){border-top:2px solid var(--amber)}
.col:nth-child(5){border-top:2px solid var(--vio)}
.col:nth-child(6){border-top:2px solid var(--acc)}
/* mobile */
@media(hover:none){
  .card:hover,.goal:hover,.rq:hover,.nav:hover{transform:none;box-shadow:none}
  .card:hover::before{opacity:0}
  .btn:hover{transform:none}
}
.card,.goal,.rq{transition:transform .2s,box-shadow .2s,border-color .2s}
/* --- цветовые акценты навигации --- */
.nav .ic{color:var(--tx3);transition:.18s}
.nav:hover .ic{color:var(--acc)}
.nav.on .ic{color:#fff}
.nav[data-p=cargo] .ic{color:var(--blue)}
.nav[data-p=trip] .ic{color:var(--cyan)}
.nav[data-p=cli] .ic{color:var(--acc)}
.nav[data-p=buy] .ic{color:var(--vio)}
.nav[data-p=fin] .ic{color:var(--amber)}
.nav[data-p=goal] .ic{color:var(--red)}
.nav.on .ic{color:#fff!important}
#gls{position:absolute;inset:0;pointer-events:none}
.chartwrap{position:relative;padding-top:4px}

/* --- мобильные фиксы --- */
