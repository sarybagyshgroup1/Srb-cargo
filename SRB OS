/* ============ ИМПОРТ ============ */
function parseCode(s){
  var p=String(s||"").trim().split(/[-–—_]/).map(function(x){return x.trim()}).filter(Boolean);
  if(!p.length)return{code:"",pcs:0};
  for(var i=0;i<p.length;i++){
    if(S.clients.find(function(c){return c.code.toUpperCase()===p[i].toUpperCase()}))
      return{code:p[i].toUpperCase(),pcs:/^\d+$/.test(p[p.length-1])?+p[p.length-1]:0};
  }
  var CITY=["OSH","OW","ОШ","BISHKEK","BSK","KG","KR","JAL","ЖАЛ","TALAS","NARYN","KARAKOL"];
  var j=0;if(/^\d+$/.test(p[0])&&p.length>2)j=1;
  var seg=[];
  while(j<p.length&&!/^\d+$/.test(p[j])&&seg.length<2){
    if(seg.length&&CITY.indexOf(p[j].toUpperCase())>-1)break;
    seg.push(p[j]);j++;
  }
  var code=seg.join("-").toUpperCase();
  var pref=(S.cfg&&S.cfg.pref||"SRB").toUpperCase();
  if(code===pref&&j<p.length&&/^\d+$/.test(p[j])&&p.length-j>1)code=pref+p[j];
  return{code:code,pcs:/^\d+$/.test(p[p.length-1])?+p[p.length-1]:0};
}
function xdate(v){
  if(typeof v==="number"&&v>20000&&v<70000)
    return new Date(Math.round((v-25569)*86400000)).toISOString().slice(0,10);
  var s=String(v||"").trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s))return s.slice(0,10);
  return "";
}
function money$(v){var m=String(v||"").match(/([\d.]+)/);return m?+m[1]:0}

var FIELDS=[["id","Номер груза 货号"],["name","Наименование 品名"],["pcs","Мест 件数"],["w","Вес 重量"],
  ["m3","Объём 体积"],["dn","Плотность 密度"],["pack","Упаковка 打包费"],["date","Дата склада 入库日期"],["cn","Кит. авто 国内车次"],["cat","Категория"]];
