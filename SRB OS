function goalVal(k){
  var st=stats();
  if(k==="rev")return S.cargo.reduce(function(a,c){return a+(c._rev||0)},0);
  if(k==="prof")return S.cargo.reduce(function(a,c){return a+(c._prof||0)},0)+S.buys.filter(buyCharged).reduce(function(a,b){return a+(+b.comm||0)},0);
  if(k==="kg")return S.cargo.reduce(function(a,c){return a+(+c.w||0)},0);
  if(k==="m3")return S.cargo.reduce(function(a,c){return a+(+c.m3||0)},0);
  if(k==="coll")return S.fin.filter(function(f){return f.t==="in"}).reduce(function(a,f){return a+f.s},0);
  if(k==="cnt")return S.cargo.length;
  if(k==="cli")return S.clients.length;
  return 0;
}
