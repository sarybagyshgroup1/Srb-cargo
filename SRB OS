  .btn:hover{transform:translateY(-2px)}
  .nav:hover{transform:translateX(2px)}
  .goal:hover{transform:translateY(-2px)}
  .rq:hover{transform:translateY(-2px)}
  .bars div:hover::after{content:attr(title)}
}
@media (hover:none){
