  x.fillStyle="#5A7568";x.font="600 12px Inter, Arial";
  var CX=[pad+10,pad+185,pad+430,pad+500,pad+575,pad+660,pad+790,W-pad-10];
  var HD=["ГРУЗ","НАИМЕНОВАНИЕ","КАТ","КГ","М³","ТАРИФ","ДОП.","СУММА $"];
  HD.forEach(function(t,i){
