  if(!list.length)return toast("У клиента нет грузов");
  var st=stats(),acc=st.acc[code]||0,paid=st.paid[code]||0;
  var W=1080,pad=44,rh=38,head=176,foot=200;
  var H=head+40+list.length*rh+foot;
  var cv=document.createElement("canvas");
