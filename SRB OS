function waText(code){
  var c=S.clients.find(function(x){return x.code===code})||{};
  var g=S.cargo.filter(function(x){return x.code===code&&x.st!=="Выдан"});
  var st=stats(),d=(st.acc[code]||0)-(st.paid[code]||0);
  var kg=g.reduce(function(a,x){return a+(+x.w||0)},0);
  return "Здравствуйте, "+(c.name||code)+"!\nВаш код: "+code+
    "\nГрузов в работе: "+g.length+", вес "+fmt(kg)+" кг"+
    (d>0?"\nК оплате: "+fmt(d)+" сом":"\nЗадолженности нет")+
    "\n\nSRB Cargo";
