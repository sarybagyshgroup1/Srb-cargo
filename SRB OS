function read(f){
  var r=new FileReader();
  r.onload=function(ev){
    try{
      var wb=XLSX.read(new Uint8Array(ev.target.result),{type:"array"});
      var sh=wb.Sheets[wb.SheetNames[0]];
      var aoa=XLSX.utils.sheet_to_json(sh,{header:1,defval:"",blankrows:false});
      if(!aoa.length)throw 0;
      var hi=0,best=-1;
      aoa.slice(0,8).forEach(function(r,i){
        var n=r.filter(function(c){var s=String(c).trim();return s&&isNaN(+s)}).length;
        if(n>best){best=n;hi=i}});
      head=aoa[hi].map(function(c){return String(c).replace(/\s+/g," ").trim()});
      rows=aoa.slice(hi+1).filter(function(r){return r.some(function(c){return String(c).trim()!==""})});
      cols={};
      FIELDS.forEach(function(F){
        var k=F[0],found=-1;
        head.forEach(function(h,i){
          if(found>-1)return;var lh=h.toLowerCase();
          for(var j=0;j<HINT[k].length;j++){if(lh.indexOf(HINT[k][j].toLowerCase())>-1){found=i;break}}
        });
        cols[k]=found;
      });
      el("fname").textContent=f.name;
      el("finfo").textContent="Лист «"+wb.SheetNames[0]+"» · заголовок в строке "+(hi+1)+" · строк: "+rows.length;
      el("map").innerHTML=FIELDS.map(function(F){
        return'<div class="fi"><label>'+F[1]+'</label><select data-f="'+F[0]+'"><option value="-1">— нет —</option>'+
          head.map(function(h,i){return'<option value="'+i+'"'+(cols[F[0]]===i?" selected":"")+'>'+esc(h||("Колонка "+(i+1)))+'</option>'}).join("")+'</select></div>'}).join("");
      document.querySelectorAll("#map select").forEach(function(s){s.onchange=function(){cols[s.dataset.f]=+s.value;preview()}});
      drop.style.display="none";el("ires").style.display="block";preview();
    }catch(err){toast("Не удалось прочитать файл")}
  };
  r.readAsArrayBuffer(f);
}

function preview(){
  if(!rows.length)return;
  var seen={};S.cargo.forEach(function(c){if(c.id)seen[String(c.id).toUpperCase()]=1});
  var gv=function(r,k){return cols[k]>-1?r[cols[k]]:""};
  var dcat=+el("defcat").value||1,batch={};
  parsed=rows.map(function(r){
    var id=String(gv(r,"id")||"").trim();
    var pc=parseCode(id);
    var w=parseFloat(String(gv(r,"w")).replace(",","."))||0;
    var m3=parseFloat(String(gv(r,"m3")).replace(",","."))||0;
    var dn=parseFloat(String(gv(r,"dn")).replace(",","."))||0;
    if(!m3&&dn>0&&w>0)m3=Math.round(w/dn*10000)/10000;
    var nm=String(gv(r,"name")||"").trim();
    var cat=parseInt(gv(r,"cat"),10);
    var ac=autoCat(nm);
    if(!(cat>=1&&cat<=4))cat=ac||dcat;
    var key=id.toUpperCase(),dup=false;
    if(key){dup=!!(seen[key]||batch[key]);batch[key]=1}
    return{id:id,code:pc.code,name:nm,
      pcs:parseInt(gv(r,"pcs"),10)||pc.pcs||1,w:w,m3:m3,d:dens(w,m3),
      pack:money$(gv(r,"pack")),date:xdate(gv(r,"date")),cn:String(gv(r,"cn")||"").trim(),
      cat:cat,auto:!!ac,dup:dup,skip:!id||!w};
  });
  var nw=parsed.filter(function(p){return!p.dup&&!p.skip});
  var dp=parsed.filter(function(p){return p.dup}).length;
  var nc=[];parsed.forEach(function(p){
    if(p.code&&!S.clients.find(function(c){return c.code===p.code})&&nc.indexOf(p.code)<0)nc.push(p.code)});
  var kg=nw.reduce(function(a,p){return a+p.w},0),m3=nw.reduce(function(a,p){return a+p.m3},0);
  var ad=parsed.filter(function(p){return p.auto&&!p.dup&&!p.skip}).length;
  el("istat").innerHTML=
    '<div class="st new"><b>'+nw.length+'</b><span>новых грузов</span></div>'+
    '<div class="st dup"><b>'+dp+'</b><span>уже в базе · пропустим</span></div>'+
    '<div class="st"><b>'+fmt(kg)+'</b><span>кг · '+f2(m3)+' м³</span></div>'+
    '<div class="st"><b>'+ad+'</b><span>категорий определено по названию</span></div>'+
    '<div class="st"><b>'+nc.length+'</b><span>новых кодов клиентов</span></div>';
  el("tprev").innerHTML=parsed.slice(0,200).map(function(p){
    var k=p.code?S.clients.find(function(c){return c.code===p.code}):null;
    var st=p.dup?'<span class="tag t-5">есть</span>':(p.skip?'<span class="tag t-r">пропуск</span>':'<span class="tag t-2">новый</span>');
    var who=k?(esc(k.name)||'<span class="mut">без имени</span>'):(p.code?'<span class="tag t-1">новый</span>':'<span class="mut">—</span>');
    return'<tr style="opacity:'+(p.dup||p.skip?".45":"1")+'"><td>'+st+'</td><td><span class="code">'+(esc(p.id)||"—")+'</span></td><td class="mono mut">'+(esc(p.code)||"—")+'</td><td>'+who+'</td><td class="mut">'+(esc(p.name)||"—")+'</td><td class="rt mono mut">'+p.pcs+'</td><td class="rt mono">'+p.w+'</td><td class="rt mono mut">'+(p.m3||"—")+'</td><td class="rt mono" style="color:var(--amber)">'+(p.d>9000?"—":fmt(p.d))+'</td><td>'+catTag(p.cat)+(p.auto?'<span class="tag t-2" style="margin-left:4px;font-size:9px">авто</span>':'')+'</td></tr>'}).join("");
}

el("commit").onclick=function(){
  var trip=el("deftrip").value,t=tripOf(trip),n=0;
  parsed.forEach(function(p){
    if(p.dup||p.skip)return;
    if(p.code)ensure(p.code);
    S.cargo.push({id:p.id,code:p.code,name:p.name,cat:p.cat,pcs:p.pcs,w:p.w,m3:p.m3,
      pack:p.pack,sell:0,cn:p.cn,trip:trip,st:t?t.st:"Склад Китай",date:p.date||today()});
    n++;
  });
  if(t&&!t.cn){var cn=parsed.find(function(p){return p.cn});if(cn)t.cn=cn.cn}
  save();render();
  el("ires").style.display="none";drop.style.display="block";file.value="";rows=[];
  toast("Загружено грузов: "+n);go("cargo");
};

