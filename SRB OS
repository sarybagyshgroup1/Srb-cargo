function animN(id,to,pre,suf){
  var e=el(id);if(!e)return;
  var from=parseFloat((e.dataset.v||"0"))||0;e.dataset.v=to;
  e.textContent=(pre||"")+fmt(to)+(suf||"");
  if(Math.abs(to-from)<1||window.innerWidth<=820||!window.requestAnimationFrame)return;
  var t0=null,dur=680;
  function step(t){
    if(t0===null)t0=t;
    var p=Math.min(1,(t-t0)/dur),k=1-Math.pow(1-p,3);
    e.textContent=(pre||"")+fmt(from+(to-from)*k)+(suf||"");
    if(p<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function spark(host,arr,col){
  var h=el(host);if(!h)return;
  var e=h.closest(".card")||h;
  var old=e.querySelector(".spark");if(old)old.remove();
  if(!arr||arr.length<2)return;
  var mx=Math.max.apply(null,arr),mn=Math.min.apply(null,arr),rg=(mx-mn)||1;
  if(mx===0&&mn===0)return;
  var W=62,H=24;
  var d=arr.map(function(v,i){
    return (i?"L":"M")+(i/(arr.length-1)*W).toFixed(1)+" "+(H-((v-mn)/rg)*H).toFixed(1)}).join(" ");
  var s=document.createElementNS("http://www.w3.org/2000/svg","svg");
  s.setAttribute("class","spark");s.setAttribute("width",W);s.setAttribute("height",H);
  s.innerHTML='<path d="'+d+'" stroke="'+col+'"/>';
  e.appendChild(s);
}
