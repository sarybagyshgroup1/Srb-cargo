function ensure(code){if(code&&!S.clients.find(function(c){return c.code===code}))S.clients.push({code:code,name:"",phone:""})}
function preCalc(){
  var w=+el("a_w").value||0,m3=+el("a_m3").value||0,cat=+el("a_cat").value||1,sell=+el("a_sell").value||0;
  var pk=(+el("a_pack").value||0)+(+el("a_svc").value||0),code=el("a_code").value.trim().toUpperCase();
  var nm=el("a_name").value.trim(),ac=autoCat(nm);
  var warn="";
  if(ac&&ac!==cat)warn='<span style="color:var(--red)">⚠ По названию «'+esc(nm)+'» это '+ac+' категория, а выбрана '+cat+'</span>';
  if(!w){el("calchint").innerHTML=warn||"Введите вес и объём — покажу плотность, ступень и прибыль";return}
  var d=dens(w,m3),t=tierFor(cat,d);
  var qty=t.byM3?m3:w,unit=t.byM3?"м³":"кг";
  var indiv=clientRate(code,cat,t.byM3);
  var auto=indiv||(t.rate+(t.byM3?S.cfg.mkM3:S.cfg.mkKg));
  if(!el("a_sell").dataset.touched){el("a_sell").value=f2(auto);sell=auto}
  var sellR=sell>0?sell:auto;
  var rev=qty*sellR+pk,cost=qty*t.rate+pk;
  el("calchint").innerHTML=(warn?warn+" ":"")+'<span>Плотность: <b>'+(d>9000?"нет объёма":fmt(d)+" кг/м³")+'</b></span>'+
    '<span>Ступень: <b>'+(t.byM3?"по кубам":t.min+"+")+'</b></span>'+
    (costv()?'<span>Себестоимость: <b>'+f2(t.rate)+' $/'+unit+'</b></span>':'')+
    '<span>Цена'+(indiv?" клиента":"")+': <b>'+f2(sellR)+' $/'+unit+'</b></span>'+
    '<span>К оплате: <b>$'+f2(rev)+'</b> · '+fmt(rev*S.cfg.usd)+' сом</span>'+
    (costv()?'<span>Прибыль: <b>$'+f2(rev-cost)+'</b></span>':'');
}
